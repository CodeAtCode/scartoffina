# Scartoffina - skill per burocrazia italiana
# Environment locale (mai in CI remota)

# === API keys per updater ===
# ISTAT SDMX: nessuna auth, ma rate limit 5 req/min
ISTAT_SDMX_BASE_URL=https://esploradati.istat.it/SDMXWS/rest

# Normattiva OpenData: CC BY 4.0, ~1 req/sec
NORMATTIVA_API_BASE_URL=https://api.normattiva.it/bff-opendata/v1

# INPS ODAPI: nessuna auth documentata
INPS_ODAPI_BASE_URL=https://serviziweb2.inps.it/odapi

# === Credenziali Tier 2 (semi) ===
# OMI ( quotazioni immobiliari): credenziali area riservata AE
OMI_USERNAME=
OMI_PASSWORD=

# Registro Imprese (InfoCamere/Telemaco): API commerciale pay-per-call
TELEMACO_API_KEY=

# === Eval ===
# API key per LLM-as-judge negli eval (Anthropic)
ANTHROPIC_API_KEY=

# === Scartoffina runtime ===
SCARTOFFINA_DATA_DIR=./data
SCARTOFFINA_COMPANY_FILE=./company.json
